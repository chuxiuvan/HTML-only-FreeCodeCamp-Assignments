<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>HTML Audio and Video Lab</title>
</head>
<body>
<h1>Welcome to Minnie's Mini Video and Music Player</h1>
<section>
  <h2>Below Here Should Be My Video Player, oopsies if it's not</h2>
  <video 
  width="640"
  controls>
  <source src="https://cdn.freecodecamp.org/curriculum/labs/what-is-the-map-method-and-how-does-it-work.mp4" muted
  type="video/mp4"
  >
  </video>
</section>
<section>
  <h2>Behold! My Music Player Below!</h2>
  <audio
  loop
  controls
  src="https://cdn.freecodecamp.org/curriculum/js-music-player/we-are-going-to-make-it.mp3">
    <source src="https://cdn.freecodecamp.org/curriculum/js-music-player/we-are-going-to-make-it.mp3"
    type="audio/mp3"

</body>
</html>
